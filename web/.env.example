# Copy to .env.local and fill in. Every one of these is optional: left unset,
# the feature compiles out entirely rather than half-working.

# Google Analytics 4 measurement id. Without it no tracking code is bundled
# and the consent prompt never appears.
VITE_GA_ID=

# Accounts and cross-device sync. Both required together. See docs/accounts.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
